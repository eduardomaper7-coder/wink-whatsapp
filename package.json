{
  "name": "wink-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp Cloud API + agente de captación + bandeja de entrada para Wink Group",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate-webhook.mts",
    "test:e2e": "vitest run tests/integration --no-file-parallelism",
    "test:sql": "bash tests/sql/run.sh",
    "send:test": "tsx scripts/send-test.mts",
    "agent:chat": "tsx scripts/agent-chat.mts",
    "demo:seed": "tsx scripts/demo-seed.mts",
    "test:ui": "node tests/ui/walkthrough.mjs",
    "test:pwa": "node tests/ui/pwa.mjs",
    "vapid:keys": "web-push generate-vapid-keys",
    "demo:reset": "tsx scripts/demo-reset.mts",
    "demo:check": "tsx scripts/demo-check.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
