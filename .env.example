# =====================================================================
# Wink · WhatsApp — variables de entorno
# Copia este archivo a .env.local (desarrollo) y configúralas en Vercel.
# Pasar del número de prueba al definitivo = cambiar el bloque WhatsApp.
# NUNCA subas .env.local al repositorio.
# =====================================================================

# --- WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp → Configuración de la API)
# Token de acceso. En producción: token permanente de un usuario del sistema
# (Business Manager → Usuarios del sistema) con whatsapp_business_messaging y whatsapp_business_management.
WHATSAPP_TOKEN=
# ID del número de teléfono (no es el número en sí). Prueba ≠ producción.
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Clave secreta de la app (Configuración de la app → Básica → Clave secreta). Firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Cadena inventada por ti; la misma que pongas en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API (v26.0 es la vigente a nov. 2026)
WHATSAPP_GRAPH_VERSION=v26.0

# --- Supabase (Project Settings → API). Proyecto en región UE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: no exponer nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=whatsapp-media

# --- Worker de la cola (/api/jobs/run). Genera uno con: openssl rand -hex 32
CRON_SECRET=

# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Agente de captación (fase 3) --------------------------------------
# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelos (configurables): conversación / clasificación (económico) / briefing (potente)
AGENT_MODEL_CHAT=claude-sonnet-5-5
AGENT_MODEL_CLASSIFY=claude-haiku-5-5
AGENT_MODEL_BRIEFING=claude-opus-5-5
# Esfuerzo del modelo de conversación: low | medium | high (medium = buen equilibrio para WhatsApp)
AGENT_EFFORT_CHAT=medium
# Segundos de espera para agrupar mensajes seguidos del cliente antes de responder
AGENT_DEBOUNCE_SECONDS=6
# Enlace a la política de privacidad (aviso en el primer contacto) — VERIFICAR la URL real de Wink
PRIVACY_POLICY_URL=https://winkgroup.es/politica-de-privacidad
# URL pública de la app (enlaces al expediente en el email y el calendario)
APP_URL=https://tu-proyecto.vercel.app

# --- Agenda de visitas ----------------------------------------------------
# demo = sin Google (huecos simulados + visitas guardadas en la BD) · google = Google Calendar real
CALENDAR_PROVIDER=demo
# Solo con google: JSON de la cuenta de servicio (tal cual o en base64) y el id del calendario
# (compartido con el email de la cuenta de servicio con permiso "Hacer cambios en eventos")
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Email del briefing (SMTP de Hostinger, gratuito) ---------------------
SMTP_HOST=smtp.hostinger.com
# 465 = SSL (recomendado) · 587 = STARTTLS si hay problemas de cifrado
SMTP_PORT=465
SMTP_USER=prueba@aibetech.es
SMTP_PASS=
EMAIL_FROM="Asistente Wink <prueba@aibetech.es>"
# Destinatario(s) del briefing del arquitecto, separados por comas
BRIEFING_EMAIL_TO=
# smtp | log (log = no envía; útil en pruebas)
EMAIL_TRANSPORT=smtp

# --- Transcripción de notas de voz (Groq Whisper, plan gratuito) ----------
# Sin clave, el agente pide amablemente que le escriban en lugar de mandar audio
GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Ensayo sin Meta: true = no envía nada a WhatsApp (chat de terminal) --
WHATSAPP_DRY_RUN=false

# --- Notificaciones push (fase 5) · genera las claves con: npm run vapid:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:prueba@aibetech.es
# webpush | log (log = no envía; útil en pruebas)
PUSH_TRANSPORT=webpush

# --- Demo (fase 6) · número que verá el público en el QR del panel /live
# Formato internacional sin "+" ni espacios (p. ej. 34910000000). Al pasar al
# número definitivo basta con cambiarlo junto con WHATSAPP_PHONE_NUMBER_ID.
NEXT_PUBLIC_DEMO_WA_NUMBER=
